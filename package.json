{
  "name": "pitstop-cli",
  "version": "0.1.0",
  "description": "Fork a running Claude Code session into a split pane with full context, run urgent tasks side by side, and merge code + knowledge back safely.",
  "type": "module",
  "bin": {
    "pit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "tsup",
    "prepublishOnly": "npm run build",
    "prepare": "tsup"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "coding-agent",
    "fork",
    "git-worktree",
    "tmux",
    "tui",
    "terminal",
    "codex",
    "gemini-cli",
    "developer-tools"
  ],
  "author": "Gowtham Kumar Solleti",
  "license": "MIT",
  "homepage": "https://github.com/gowtham012/pitstop#readme",
  "bugs": {
    "url": "https://github.com/gowtham012/pitstop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gowtham012/pitstop.git"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "commander": "^15.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
